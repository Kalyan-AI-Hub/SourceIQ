# SourcingIntel — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# ── Azure AI Foundry SDK v2 (optional — cloud path) ───────────────────
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_PROJECT_NAME=
AZURE_SUBSCRIPTION_ID=

# ── Bing Search API (live geo risk news — optional) ───────────────────
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ── Foundry Local (on-device inference + embeddings) ──────────────────
# FOUNDRY_LOCAL_MODEL is required — the model alias or full ID to load.
FOUNDRY_LOCAL_MODEL=phi-4-mini
# FOUNDRY_LOCAL_ENDPOINT is optional — foundry-local-sdk auto-discovers the port.
# Override only if Foundry Local runs on a non-default port.
 FOUNDRY_LOCAL_ENDPOINT= #where foundry service is running
# FOUNDRY_LOCAL_APP_NAME=sourceiq
#
# Set FOUNDRY_USE_SDK=false to bypass the SDK and use raw HTTP (instant rollback).
# FOUNDRY_USE_SDK=true

# ── Local databases (file paths, no cloud keys needed — REQUIRED) ─────
LANCEDB_PATH=./data/lancedb
SQLITE_PATH=./data/sourceiq.db

# ── GDELT (free public API, no key required — REQUIRED) ───────────────
GDELT_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc

# ── US State Dept Travel Advisories (free, no key — optional) ─────────
STATE_DEPT_ADVISORY_URL=https://travel.state.gov/content/travel/en/traveladvisories/traveladvisories.html/_jcr_content/travelAdvisoryLibrary.json

# ── App (REQUIRED) ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
RISK_POLL_INTERVAL_MS=300000

# ── Morning Brief Email (optional — leave blank to disable) ───────────
# Recipient email address for daily morning brief
ALERT_EMAIL_TO=buyer@yourcompany.com
# SMTP server config (Gmail example: use an App Password, not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
